PORT=5000
NODE_ENV=development

MONGODB_DB_NAME=nguyenlien_dev
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app-name>

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

JWT_ACCESS_SECRET=<your_jwt_access_secret>
JWT_ACCESS_EXPIRES_IN=60m

JWT_REFRESH_SECRET=<your_jwt_refresh_secret>
JWT_REFRESH_EXPIRES_IN=1d

BCRYPT_SALT_ROUNDS=10

SMS_PROVIDER=mock
SMS_OTP_LENGTH=6
SMS_OTP_TTL_SECONDS=300
SMS_OTP_RESEND_SECONDS=60
SMS_OTP_WINDOW_SECONDS=900
SMS_OTP_MAX_REQUESTS=5
SMS_OTP_MAX_ATTEMPTS=5

SEED_ADMIN_PASSWORD=<your_seed_admin_password>
SEED_MANAGER_PASSWORD=<your_seed_manager_password>

INTERNAL_API_KEY=<your_internal_api_key>

SHIPMENT_WEBHOOK_SECRET=<your_shipment_webhook_secret>
SHIPMENT_WEBHOOK_SECRET_GHN=<your_ghn_shipment_webhook_secret>
DEFAULT_SHIPPING_FEE=0

GEMINI_API_KEY=<your_gemini_api_key>

CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>
CLOUDINARY_UPLOAD_FOLDER=nguyen-lien-shop

MAIL_USE_ETHEREAL=true

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_VERIFY_ON_STARTUP=false
MAIL_USER=<your_email>
MAIL_PASS=<your_mail_app_password>
MAIL_FROM_NAME="NguyenLien Shop"
MAIL_FROM_ADDRESS=<your_email>

VNPAY_TMN_CODE="<your_vnpay_tmn_code>"
VNPAY_SECURE_SECRET="<your_vnpay_secure_secret>"
VNPAY_RETURN_URL="http://localhost:5000/api/v1/payments/vnpay-return"
VNPAY_TEST_MODE="true"
VNPAY_CHECKOUT_ENABLED="false"
VNPAY_HASH_ALGORITHM="SHA512"
VNPAY_ENABLE_LOG="false"
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_IPN_URL="<your_public_backend_url>/api/v1/payments/webhook/vnpay"

FRONTEND_URL="http://localhost:5173"

STRIPE_SECRET_KEY=<your_stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<your_stripe_webhook_secret>

PAYPAL_CLIENT_ID=<your_paypal_client_id>
PAYPAL_CLIENT_SECRET=<your_paypal_client_secret>
PAYPAL_WEBHOOK_ID=<your_paypal_webhook_id>
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYOS_CLIENT_ID=<your_payos_client_id>
PAYOS_API_KEY=<your_payos_api_key>
PAYOS_CHECKSUM_KEY=<your_payos_checksum_key>
PAYOS_CHECKOUT_ENABLED=true
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOS_WEBHOOK_URL=<your_public_backend_url>/api/v1/payments/payos/webhook
PAYOS_PAYMENT_EXPIRE_MINUTES=15
